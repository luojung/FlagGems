#!/usr/bin/env bash
# Independent Apptainer development environment; production activation is untouched.
set -euo pipefail
ROOT=/work1/share/scnethpc2601/flagos-dev/20261103-hygon-optimization
APPTAINER=/public/software/apps/apptainer/1.3.4/bin/apptainer
IMAGE=$ROOT/images/flagos-dev-20261103.rootfs
SOURCE=
PROFILE=boxing
while (($#)); do
 case "$1" in
  --source) (($#>=2)) || { echo '--source requires a FlagGems checkout' >&2;exit 2; }; SOURCE=$(realpath -e -- "$2"); test -f "$SOURCE/src/flag_gems/__init__.py";shift 2;;
  --profile) (($#>=2)) || { echo '--profile requires primary or boxing' >&2;exit 2; }; PROFILE=$2; [[ "$PROFILE" = primary || "$PROFILE" = boxing ]] || { echo "Unsupported profile: $PROFILE" >&2;exit 2; };shift 2;;
  --sif) IMAGE=$ROOT/images/flagos-dev-20261103.sif;shift;;
  --) shift;break;;
  -h|--help) printf 'Usage: bash %s [--sif] [--profile primary|boxing] [--source FLAGGEMS_CHECKOUT] -- COMMAND [ARGS...]\n' "$0";exit 0;;
  *) break;;
 esac
done
(($#)) || set -- /bin/bash --noprofile --norc -i
test -e "$IMAGE" || { echo "Missing development image: $IMAGE" >&2;exit 1; }
# Inherited container injections and shared-environment routes must not alter this image.
for n in ${!APPTAINERENV_@} ${!SINGULARITYENV_@};do unset "$n";done
unset APPTAINER_BIND APPTAINER_BINDPATH SINGULARITY_BIND SINGULARITY_BINDPATH
unset PYTHONHOME PYTHONPATH LD_PRELOAD
CACHE=${FLAGOS_DEV_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/flagos-dev/20261103-${USER}}
mkdir -p "$CACHE"/{triton,flaggems,torchinductor,pip,tmp,home}
chmod 700 "$CACHE" "$CACHE/tmp"
export APPTAINER_CACHEDIR=$CACHE/apptainer APPTAINER_TMPDIR=$CACHE/tmp
# Preserve scheduler ownership, GPU allocation, rank and rendezvous variables explicitly.
while IFS= read -r n;do
 case "$n" in SLURM_*|PMI_*|PMIX_*|UCX_*|HSA_VISIBLE_DEVICES|HIP_VISIBLE_DEVICES|ROCR_VISIBLE_DEVICES|CUDA_VISIBLE_DEVICES|RANK|LOCAL_RANK|WORLD_SIZE|MASTER_ADDR|MASTER_PORT|RESULT_DIR) export "APPTAINERENV_$n=${!n}";;esac
done < <(compgen -e)
export APPTAINERENV_FLAGOS_DEV_CACHE=$CACHE
export APPTAINERENV_FLAGOS_PYTHON_PREFIX=/opt/flagos/python
export APPTAINERENV_FLAGOS_DEV_ROOT=/opt/flagos
if [[ "$PROFILE" = boxing ]];then
 export APPTAINERENV_FLAGOS_BACKEND_CONFIG=/opt/flagos/python/lib/python3.10/site-packages/torch_fl/configs/backends_hygon_boxing.conf
fi
export APPTAINERENV_FLAGOS_DEV_SOURCE=
ARGS=(exec --cleanenv --no-home --no-mount hostfs --pwd "$PWD"
 --bind "$PWD:$PWD" --bind "$CACHE:$CACHE"
 --bind /public/software/compiler/dtk-26.04:/public/software/compiler/dtk-26.04:ro
 --bind /public/software/mpi/openmpi-dtk_2604/5.0.3:/public/software/mpi/openmpi-dtk_2604/5.0.3:ro
 --bind /public/software/base/ucx-dtk_2604/1.17.0:/public/software/base/ucx-dtk_2604/1.17.0:ro
 --bind /public/software/base/libevent-dtk_2604/2.1.12:/public/software/base/libevent-dtk_2604/2.1.12:ro
 --bind /public/software/base/hwloc-dtk_2604/2.12.2:/public/software/base/hwloc-dtk_2604/2.12.2:ro
 --bind /public/software/base/pmix-dtk_2604/5.0.8:/public/software/base/pmix-dtk_2604/5.0.8:ro
 --bind /usr/local/hyhal:/usr/local/hyhal:ro --bind /opt/hyhal:/opt/hyhal:ro)
if [[ "$HOME" != "$PWD" ]];then ARGS+=(--bind "$HOME:$HOME");fi
if [[ -n "$SOURCE" ]];then
 ARGS+=(--bind "$SOURCE:/opt/flagos/live-FlagGems:ro")
 export APPTAINERENV_FLAGOS_DEV_SOURCE=/opt/flagos/live-FlagGems
 printf 'FlagGems source override: %s\n' "$SOURCE" >&2
 git -c safe.directory="$SOURCE" -c core.fsmonitor=false -C "$SOURCE" rev-parse HEAD >&2
 git -c safe.directory="$SOURCE" -c core.fsmonitor=false -C "$SOURCE" status --short >&2
fi
exec "$APPTAINER" "${ARGS[@]}" "$IMAGE" /bin/bash /opt/flagos/scripts/entry.sh "$@"
